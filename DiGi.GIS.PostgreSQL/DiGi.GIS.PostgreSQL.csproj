<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
	<OutputPath>..\bin\</OutputPath>
	<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
	<AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
	<Nullable>enable</Nullable>
	<GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

	<PropertyGroup>
		<!-- Redirect AssemblyAttributes.cs so each project has its own -->
		<TargetFrameworkMonikerAssemblyAttributesPath>$(IntermediateOutputPath)$(MSBuildProjectName).AssemblyAttributes.cs</TargetFrameworkMonikerAssemblyAttributesPath>
		<!-- Avoid duplicate TargetFrameworkAttribute -->
		<GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
	</PropertyGroup>
	<ItemGroup>
		<!-- Prevent duplicate 'Compile' inclusion of the generated AssemblyAttributes.cs -->
		<Compile Remove="$(IntermediateOutputPath)$(MSBuildProjectName).AssemblyAttributes.cs" />
	</ItemGroup>
	<ItemGroup>
	  <!-- NetTopologySuite is a NuGet dependency of DiGi.Geometry (referenced via HintPath below). The party wall pass
	       calls DiGi.Geometry.Planar.Query.InRange, whose overload set names NetTopologySuite.Geometries.Geometry, so
	       the compiler needs the assembly to resolve the call (CS0012) even though no such type crosses this API. -->
	  <PackageReference Include="NetTopologySuite" Version="2.6.0" />
	  <PackageReference Include="Npgsql" Version="10.0.2" />
	  <!-- DiGi.GIS.IO's streaming readers for the open building datasets (DiGi.GIS.IO#17): DiGi.GIS.IO is
	       referenced by HintPath, so its NuGet dependencies never reach this host from NuGet, and the
	       Sqlite provider would only fail at its native e_sqlite3 on the first read. -->
	  <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.5" />
	  <PackageReference Include="NetTopologySuite.IO.GeoPackage" Version="2.0.0" />
	  <PackageReference Include="Parquet.Net" Version="5.5.0" />
	  <!-- Pin above the version Parquet.Net 5.5.0 resolves to (GHSA-pggp-6c3x-2xmx, NU1903). -->
	  <PackageReference Include="Snappier" Version="1.3.1" />
	  <!-- Pin above the version Microsoft.Data.Sqlite 10.0.5 resolves to (GHSA-2m69-gcr7-jv3q, NU1903). -->
	  <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.14" />
	  <!-- ProjNET4GeoAPI is a NuGet dependency of DiGi.GIS (referenced via HintPath below). The open building
	       import builds one GeoAPI.CoordinateSystems.Transformations.ICoordinateTransformation per run and names
	       that type, so this project must re-declare the package at the same version or the call sites fail with
	       CS0012 (DiGi.GIS.PostgreSQL#125, DiGi.GIS#21). -->
	  <PackageReference Include="ProjNET4GeoAPI" Version="1.4.1" />
	  <!-- OsmSharp is a NuGet dependency of DiGi.OSM (referenced via HintPath below). DiGi.OSM is netstandard2.0
	       and its NuGet dependencies never reach this host through the HintPath, so the PBF reader would fail at
	       its OsmSharp types on the first OSM import (DiGi.GIS.PostgreSQL#125). -->
	  <PackageReference Include="OsmSharp" Version="6.2.0" />
	  <!-- IAsyncEnumerable<> of the DiGi.GIS.IO streaming readers is defined in this assembly (DiGi.GIS.IO is
	       netstandard2.0); the import task's await foreach asks for it by name with CS0012 otherwise
	       (DiGi.GIS.PostgreSQL#125). -->
	  <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="10.0.9" />
	</ItemGroup>

	<Target Name="CopyUserFiles" AfterTargets="Build">
		<ItemGroup>
			<_UserFiles Include="$(ProjectDir)..\user files\**\*.*" />
		</ItemGroup>
		<Message Text="Copying all user files from directory..." Importance="high" />
		<Copy SourceFiles="@(_UserFiles)" DestinationFiles="@(_UserFiles->'$(OutputPath)%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
	</Target>

  <ItemGroup>
    <Reference Include="DiGi.Analytical">
      <HintPath>..\..\DiGi.Analytical\bin\DiGi.Analytical.dll</HintPath>
    </Reference>
    <Reference Include="DiGi.Analytical.Building">
      <HintPath>..\..\DiGi.Analytical\bin\DiGi.Analytical.Building.dll</HintPath>
    </Reference>
    <Reference Include="DiGi.BDL">
      <HintPath>..\..\DiGi.BDL\bin\DiGi.BDL.dll</HintPath>
    </Reference>
    <Reference Include="DiGi.CityGML">
      <HintPath>..\..\DiGi.CityGML\bin\DiGi.CityGML.dll</HintPath>
    </Reference>
    <Reference Include="DiGi.Core">
      <HintPath>..\..\DiGi.Core\bin\DiGi.Core.dll</HintPath>
    </Reference>
    <Reference Include="DiGi.Core.Parameter">
      <HintPath>..\..\DiGi.Core\bin\DiGi.Core.Parameter.dll</HintPath>
    </Reference>
    <Reference Include="DiGi.EPW">
      <HintPath>..\..\DiGi.EPW\bin\DiGi.EPW.dll</HintPath>
    </Reference>
    <Reference Include="DiGi.Core.IO">
      <HintPath>..\..\DiGi.Core\bin\DiGi.Core.IO.dll</HintPath>
    </Reference>
    <Reference Include="DiGi.Core.Relation">
      <HintPath>..\..\DiGi.Core\bin\DiGi.Core.Relation.dll</HintPath>
    </Reference>
    <Reference Include="DiGi.Geometry">
      <HintPath>..\..\DiGi.Geometry\bin\DiGi.Geometry.dll</HintPath>
    </Reference>
    <Reference Include="DiGi.Geometry.Object">
      <HintPath>..\..\DiGi.Geometry\bin\DiGi.Geometry.Object.dll</HintPath>
    </Reference>
    <Reference Include="DiGi.Geometry.PointCloud">
      <HintPath>..\..\DiGi.Geometry.PointCloud\bin\DiGi.Geometry.PointCloud.dll</HintPath>
    </Reference>
    <Reference Include="DiGi.GIS">
      <HintPath>..\..\DiGi.GIS\bin\DiGi.GIS.dll</HintPath>
    </Reference>
    <Reference Include="DiGi.GIS.Analytical">
      <HintPath>..\..\DiGi.GIS.Analytical\bin\DiGi.GIS.Analytical.dll</HintPath>
    </Reference>
    <Reference Include="DiGi.GIS.Emgu.CV">
      <HintPath>..\..\DiGi.GIS.Emgu.CV\bin\DiGi.GIS.Emgu.CV.dll</HintPath>
    </Reference>
    <Reference Include="DiGi.GIS.IO">
      <HintPath>..\..\DiGi.GIS.IO\bin\DiGi.GIS.IO.dll</HintPath>
    </Reference>
    <Reference Include="DiGi.OSM">
      <HintPath>..\..\DiGi.OSM\bin\DiGi.OSM.dll</HintPath>
    </Reference>
    <Reference Include="DiGi.Serilog">
      <HintPath>..\..\DiGi.Serilog\bin\DiGi.Serilog.dll</HintPath>
    </Reference>
    <Reference Include="DiGi.PostgreSQL">
      <HintPath>..\..\DiGi.PostgreSQL\bin\DiGi.PostgreSQL.dll</HintPath>
    </Reference>
    <Reference Include="DiGi.PostgreSQL.Table">
      <HintPath>..\..\DiGi.PostgreSQL\bin\DiGi.PostgreSQL.Table.dll</HintPath>
    </Reference>
    <Reference Include="DiGi.Typology">
      <HintPath>..\..\DiGi.Typology\bin\DiGi.Typology.dll</HintPath>
    </Reference>
    <Reference Include="DiGi.Weather">
      <HintPath>..\..\DiGi.Weather\bin\DiGi.Weather.dll</HintPath>
    </Reference>
  </ItemGroup>

</Project>
